@model Check_IMC.Models.ImcModel

@{
    ViewData["Title"] = "Calculadora IMC";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <h3 class="text-center mb-4">Calculadora de IMC</h3>
            <form asp-action="Index" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Weight" class="form-label">Peso (kg):</label>
                    <input asp-for="Weight" class="form-control" placeholder="Ex: 70.5" />
                    <span asp-validation-for="Weight" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Height" class="form-label">Altura (m):</label>
                    <input asp-for="Height" class="form-control" placeholder="Ex: 1.75" />
                    <span asp-validation-for="Height" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <input asp-action="ImcCalculator" type="submit" value="Calcular IMC" class="btn btn-primary" />
                </div>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Index" class="text-secondary text-decoration-none">↩ Voltar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
